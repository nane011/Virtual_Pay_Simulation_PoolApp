@model List<Virtual_Pay_Simulation.Models.Service>
@{
    ViewData["Title"] = "Mevcut Hizmetler";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="text-center mb-4">Mevcut Hizmetler</h2>
    <div class="row">
        @foreach (var service in Model)
        {
            @if (service.IsActive == true)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow h-100">
                        <div class="btn-group mb-3">
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@service.Title</h5>
                            <p class="card-text">@service.Description</p>
                            <p class="card-text text-muted">Fiyat: ₺@service.StudentPrice</p>
                            <p class="card-text text-muted">Fiyat: ₺@service.StaffPrice</p>
                            <p class="card-text text-muted">Fiyat: ₺@service.MemberPrice</p>
                            <p class="card-text text-muted">Tarih: @service.StartTime.ToShortDateString() - @service.EndTime.ToShortDateString()</p>

                            @if (service.PayDueDate < DateTime.Today)
                            {
                                <div class="alert alert-warning p-2 mt-3 text-center">
                                    Bu hizmet için alımlar kapanmıştır.
                                </div>
                            }
                            else
                            {
                                <a asp-controller="User" asp-action="ServiceInfo" asp-route-id="@service.ServiceId" class="btn btn-primary mt-2">Detayları Gör</a>
                            }
                        </div>
                    </div>
                </div>
            }
            
        }
    </div>
    <a asp-action="MainPage" asp-controller="User" class="btn btn-secondary mb-3">
        ← Geri
    </a>
</div>
