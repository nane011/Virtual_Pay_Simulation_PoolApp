@model List<Announcement>

@if (!Model.Any())
{
    <div class="alert alert-info">Gösterilecek aktif duyuru bulunmamaktadır.</div>
}
else
{
    <div class="accordion" id="activeAnnouncementsAccordion">
        @foreach (var announcement in Model)
        {
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-active-@announcement.AnnouncementId">
                        <strong>@announcement.Title</strong>&nbsp; (Yayınlanma Tarihi: @announcement.AddDate.ToString("dd MMMM yyyy"))
                    </button>
                </h2>
                <div id="collapse-active-@announcement.AnnouncementId" class="accordion-collapse collapse" data-bs-parent="#activeAnnouncementsAccordion">
                    <div class="accordion-body bg-light">
                        <h6>@announcement.Description</h6>
                        <hr />
                        <p>@announcement.Description2</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <small class="text-muted">Yayınlanma: @announcement.AddDate.ToString("dd MMMM yyyy, HH:mm")</small>
                    </div>
                </div>
            </div>
        }
    </div>
}