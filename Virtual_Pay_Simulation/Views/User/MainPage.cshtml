@{
    ViewBag.Title = "Kullanıcı Paneli";
    var userName = ViewBag.UserName ?? "Kullanıcı";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 bg-dark text-white min-vh-100 p-4">
            <h3 class="mb-4 text-center">🌟 Merhaba, @userName</h3>
            <hr class="border-light" />

            <div class="d-grid gap-3">
                <a class="btn btn-outline-light" href="/User/Profile">Profilim</a>
                <a class="btn btn-outline-light" href="/User/Services">Hizmetler</a>
                <a class="btn btn-outline-light" href="/User/CurrentSessions">Seanslarım</a>
                <a class="btn btn-outline-light" href="/User/Announcement">Duyurular</a>
                <hr class="border-light" />
                <a class="btn btn-danger" href="/Public/FirstPage">Çıkış Yap</a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-9 p-5">
            <h2 class="mb-4">Hoşgeldiniz @userName 👋</h2>
        </div>
    </div>
</div>
