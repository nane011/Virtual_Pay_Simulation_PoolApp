@model Virtual_Pay_Simulation.Models.ViewModels.AdminServiceInfoViewModel
@{
    ViewData["Title"] = "Seans Yönetimi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">@Model.Service.Title</h2>
            <p class="lead text-muted">Seans Yönetimi</p>
        </div>
        <a asp-action="CurrentServices" asp-controller="Admin" class="btn btn-secondary">← Hizmetlere Dön</a>
    </div>

    <div class="row">
        @if (Model.SessionGroups.Any())
        {
            @foreach (var group in Model.SessionGroups)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header fw-bold">
                            @group.TemplateName (@group.Gender)
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@group.StartTime.ToString("hh\\:mm") - @group.EndTime.ToString("hh\\:mm")</h5>
                            <p class="card-text"><strong>Günler:</strong> @group.Days</p>
                            <p>
                                <span class="badge bg-warning text-dark">Başvuran: @group.ApplicantCount</span>
                                <span class="badge bg-success">Katılımcı: @group.ParticipantCount / @group.MaxCapacity</span>
                            </p>
                            <a asp-action="SessionDetail" asp-controller="Admin" asp-route-serviceId="@Model.Service.ServiceId" asp-route-groupIdentifier="@group.GroupIdentifier" class="btn btn-primary">Detayları Görüntüle</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col">
                <div class="alert alert-info">Bu hizmet için oluşturulmuş seans bulunmamaktadır.</div>
            </div>
        }

        @if (!Model.Service.IsActive)
        {
            <hr />
            <div class="card bg-light mt-4">
                <div class="card-header">
                    <strong>Yönetim İşlemleri</strong>
                </div>
                <div class="card-body d-flex justify-content-end">
                    <form asp-action="PublishService" asp-controller="Admin" method="post" class="me-2">
                        <input type="hidden" name="id" value="@Model.Service.ServiceId" />
                        <button type="submit" class="btn btn-success" onclick="return confirm('Bu hizmeti ve içindeki tüm seansları yayınlamak istediğinizden emin misiniz?')">
                            Hizmeti Yayınla
                        </button>
                    </form>
                    <form asp-action="DeleteService" asp-controller="Admin" method="post">
                        <input type="hidden" name="id" value="@Model.Service.ServiceId" />
                        <button type="submit" class="btn btn-danger" onclick="return confirm('DİKKAT: Bu hizmeti ve içindeki tüm seansları kalıcı olarak silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.')">
                            Hizmeti Sil
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
