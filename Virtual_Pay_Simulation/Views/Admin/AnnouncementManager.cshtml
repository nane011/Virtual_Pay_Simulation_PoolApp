@{
    ViewData["Title"] = "Duyuru Yönetimi";
}

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">@ViewData["Title"]</h2>
        </div>
        <a href="/Admin/AdminPan" class="btn btn-secondary">Geri</a>
    </div>

    <ul class="nav nav-tabs" id="announcementTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="new-announcement-tab" data-bs-toggle="tab" type="button">Yeni Duyuru Ekle</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="active-announcements-tab" data-bs-toggle="tab" type="button">Aktif Duyurular</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="past-announcements-tab" data-bs-toggle="tab" type="button">Geçmiş Duyurular</button>
        </li>
    </ul>

    <div class="tab-content pt-3">
        <div id="contentArea">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {

            // --- YÜKLEME FONKSİYONLARI ---
            function loadNewAnnouncementForm() {
                $("#contentArea").html('<div class="text-center p-4"><div class="spinner-border"></div></div>');
                $("#contentArea").load('@Url.Action("LoadNewAnnouncementPartial", "Admin")');
            }

            function loadActiveAnnouncements() {
                $("#contentArea").html('<div class="text-center p-4"><div class="spinner-border"></div></div>');
                $("#contentArea").load('@Url.Action("LoadActiveAnnouncementsPartial", "Admin")');
            }

            function loadPastAnnouncements() {
                $("#contentArea").html('<div class="text-center p-4"><div class="spinner-border"></div></div>');
                $("#contentArea").load('@Url.Action("LoadPastAnnouncementsPartial", "Admin")');
            }

            // --- TIKLAMA OLAYLARI ---
            $('#new-announcement-tab').on('click', loadNewAnnouncementForm);
            $('#active-announcements-tab').on('click', loadActiveAnnouncements);
            $('#past-announcements-tab').on('click', loadPastAnnouncements);

            // --- SİLME İŞLEMİ ---
            // contentArea dinamik olarak yüklendiği için event delegation kullanıyoruz.
            $('#contentArea').on('click', '.delete-announcement-btn', function() {
                var button = $(this);
                var announcementId = button.data('id');

                if (confirm('Bu duyuruyu silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.')) {
                    $.post('@Url.Action("DeleteAnnouncement", "Admin")', { id: announcementId }, function(response) {
                        if (response.success) {
                            alert(response.message); // veya daha şık bir toastr mesajı
                            // Hangi sekme aktifse onu yeniden yükle
                            if ($('#active-announcements-tab').hasClass('active')) {
                                loadActiveAnnouncements();
                            } else if ($('#past-announcements-tab').hasClass('active')) {
                                loadPastAnnouncements();
                            }
                        } else {
                            alert('Hata: ' + response.message);
                        }
                    });
                }
            });

            // Sayfa ilk açıldığında "Yeni Duyuru Ekle" sekmesini otomatik yükle
            loadNewAnnouncementForm();
        });
    </script>
}