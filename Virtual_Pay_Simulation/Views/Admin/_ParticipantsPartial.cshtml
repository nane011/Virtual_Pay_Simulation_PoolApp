@model Virtual_Pay_Simulation.Models.ViewModels.AdminParticipantsViewModel

@if (Model == null || !Model.Participants.Any())
{
    <div class="alert alert-info mt-3 text-center">Bu seans grubuna ödeme yapmış katılımcı bulunmamaktadır.</div>
}
else
{
    <div class="mt-3">
        <h5 class="mb-3">
            <span class="badge bg-success" style="font-size: 1rem;">
                Katılımcılar (@Model.Participants.Count)
            </span>
        </h5>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Ad Soyad</th>
                        <th>TC Kimlik No</th>
                        <th>Kullanıcı Tipi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Participants)
                    {
                        <tr>
                            <td>@user.Name @user.Surname</td>
                            <td>@user.UserName</td>
                            <td>@user.UserType</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}