@{
    ViewBag.Title = "Ödeme Bilgileri";
    bool uyeBulundu = ViewBag.UyeVar == true;
}

<div class="container mt-5">
    <div class="card shadow">
        <form asp-action="Create" method="post" autocomplete="off">
            <div class="card-header bg-secondary text-white">
                <h3 class="mb-0">Ödeme Bilgileri</h3>
            </div>
            <div class="card-body">

                @* Kullanıcı bilgileri *@
                <div class="mb-3">
                    <label class="form-label">Ad</label>
                    <input type="text" name="Ad" class="form-control" required value="@ViewBag.Ad" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Soyad</label>
                    <input type="text" name="Soyad" class="form-control" required value="@ViewBag.Soyad" />
                </div>
                <div class="mb-3">
                    <label class="form-label">TC Kimlik No</label>
                    <input type="text" name="TC" class="form-control" required maxlength="11" value="@ViewBag.TC" />
                </div>

                @* Kullanıcı bulunamadı veya bulundu mesajı *@
                @if (ViewBag.Mesaj != null)
                {
                    <div class="alert @(uyeBulundu ? "alert-success" : "alert-danger")">
                        @ViewBag.Mesaj
                    </div>
                }

                @* Kart bilgileri sadece kullanıcı varsa göster *@
                @if (uyeBulundu)
                {
                    <hr />
                    <div class="mb-3">
                        <label class="form-label">Kart Numarası</label>
                        <input type="text" name="KartNo" class="form-control" maxlength="16" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Son Kullanma Tarihi</label>
                            <input type="text" name="SonKullanmaTarihi" class="form-control" placeholder="MM/YY" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">CVC</label>
                            <input type="text" name="CVC" class="form-control" maxlength="4" required />
                        </div>
                    </div>
                }
            </div>
            <div class="card-footer p-0">
                <button type="submit" class="btn btn-success btn-lg w-100 rounded-0">
                    @(uyeBulundu ? "Devam Et" : "Sorgula")
                </button>
            </div>
        </form>
    </div>
</div>
