@{
    ViewData["Title"] = "Sanal POS";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">Sanal POS Doğrulama</h3>
        </div>
        <div class="card-body">
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger text-center">
                    @ViewBag.ErrorMessage
                </div>
            }
            <form asp-action="ConfirmSubmit" method="post" autocomplete="off">
                <div class="mb-3">
                    <label class="form-label">Robot Doğrulama Kodu</label>
                    <div class="form-control fw-bold text-center">
                        @ViewBag.RandomCode
                    </div>
                    <input type="hidden" name="generatedCode" value="@ViewBag.RandomCode" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Doğrulama Kodu</label>
                    <input type="text" name="userCode" class="form-control" placeholder="Doğrulama kodunu girin" required />
                </div>
                <p class="text-muted">Geliştirme aşamasındayız</p>
                <button type="submit" class="btn btn-success w-100">Ödeme Yap</button>
            </form>
        </div>
    </div>
</div>
