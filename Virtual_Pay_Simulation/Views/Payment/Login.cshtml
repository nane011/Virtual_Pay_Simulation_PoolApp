@{
    ViewData["Title"] = "Giriş Yap";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h3 class="text-center mb-3">Giriş Yap</h3>

        @if (ViewBag.LoginError != null)
        {
            <div class="alert alert-danger text-center">
                @ViewBag.LoginError
            </div>
        }

        <form asp-action="Login" method="post" autocomplete="off">
            <div class="mb-3">
                <label class="form-label">TC Kimlik No</label>
                <input type="text" name="tc" class="form-control" maxlength="11" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Şifre</label>
                <input type="password" name="sifre" class="form-control" required>
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-success">Giriş Yap</button>
                <a href="/Payment/FirstPage" class="btn btn-secondary">Geri</a>
            </div>
        </form>
    </div>
</div>
